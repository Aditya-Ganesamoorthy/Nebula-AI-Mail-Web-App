# Nebula AI Mail - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to Git!

# Environment & Server
ENVIRONMENT=development
DEBUG=True
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Google Cloud OAuth 2.0 Credentials (Server-side Web Application Client)
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Groq API (High-performance LLM tool calling)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Cloud Pub/Sub (Real-time Gmail push notifications)
# Pub/Sub topic format: projects/{project-id}/topics/{topic-name}
PUBSUB_TOPIC=projects/your-project-id/topics/gmail-push-topic
PUBSUB_VERIFICATION_TOKEN=your-random-pubsub-verification-token

# Security & Session Secrets
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=your-secure-random-32-byte-session-secret-here
